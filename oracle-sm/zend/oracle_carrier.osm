oracle_sm_family oracle_zend_array_carrier

purpose "Oracle/PASM JinxValue carrier for native JinxZendArray pointers."
replaces "Count-only array placeholder where a real Zend-array pointer is available."

native_files {
  runtime/jinx_oracle_zend_array_carrier.h
  runtime/jinx_oracle_zend_array_builtins.h
  build/oracle-asm/jinx_oracle_asm_runtime.h
}

native_symbols {
  JINX_ORACLE_VALUE_ZEND_ARRAY
  jinx_oracle_zend_array_value_borrowed
  jinx_oracle_zend_array_value_retained
  jinx_oracle_value_is_zend_array
  jinx_oracle_zend_array_ptr
  jinx_oracle_zend_array_value_release
}

oracle_sm_contract {
  JinxValue.type       JINX_ORACLE_VALUE_ZEND_ARRAY
  JinxValue.as.ptr     pointer_to_JinxZendArray
  JinxValue.flags      borrowed_or_retained
  release_rule         release_only_retained_carrier
  dispatch_rule        route_array_builtins_before_count_fallback
}

proven_by {
  scripts/build-oracle-zend-array-carrier-smoke.sh
  build/native/jinx-oracle-zend-array-carrier-smoke
  scripts/build-oracle-zend-array-builtin-smoke.sh
  build/native/jinx-oracle-zend-array-builtin-smoke
}

pasm_target "runtime/pasm/zend/oracle_carrier.pasm"
status started
