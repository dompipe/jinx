# Jinx Oracle-SM second procedural batch
# PHP/Zend behavior is the compatibility contract.
# No target is complete until a real native handler and PHP comparison prove it.

batch procedural_needed_200 {
  count 200
  status implementing

targets {
  _
  assert
  assert_options
