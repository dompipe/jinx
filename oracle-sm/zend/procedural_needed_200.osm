rules {
  "No fabricated success values."
  "No PHP subprocess delegation."
  "Invalid PHP argument paths fault instead of becoming successful null/false."
  "Stateful resources use native carriers."
  "Every completed family gets a PHP-vs-Jinx parity test."
}
}
